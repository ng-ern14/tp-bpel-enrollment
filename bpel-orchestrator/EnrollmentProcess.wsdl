<?xml version="1.0" encoding="UTF-8"?>
<!-- Contract of the orchestrator : the BPEL process is itself a web service
     with one operation enroll(enrollRequest) -> enrollResponse. -->
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="http://tp.bpel/enrollment/"
             xmlns:plnk="http://docs.oasis-open.org/wsbpel/2.0/plnktype"
             targetNamespace="http://tp.bpel/enrollment/"
             name="EnrollmentProcess">

    <types>
        <xsd:schema>
            <xsd:import namespace="http://tp.bpel/enrollment/" schemaLocation="types/enrollment.xsd"/>
        </xsd:schema>
    </types>

    <message name="enrollIn"><part name="payload" element="tns:enrollRequest"/></message>
    <message name="enrollOut"><part name="payload" element="tns:enrollResponse"/></message>

    <portType name="EnrollmentPT">
        <operation name="enroll">
            <input message="tns:enrollIn"/>
            <output message="tns:enrollOut"/>
        </operation>
    </portType>

    <!-- role played by the process towards the student client.
         The partner-link types towards the 4 services (UniversityLT, BankLT,
         ResidenceLT, TransportLT) are declared in the partner WSDLs. -->
    <plnk:partnerLinkType name="EnrollmentLT">
        <plnk:role name="enrollmentProvider" portType="tns:EnrollmentPT"/>
    </plnk:partnerLinkType>

    <binding name="EnrollmentSOAP" type="tns:EnrollmentPT">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="enroll">
            <soap:operation soapAction="enroll"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
    </binding>

    <service name="EnrollmentService">
        <port name="EnrollmentPort" binding="tns:EnrollmentSOAP">
            <soap:address location="http://localhost:8080/ode/processes/EnrollmentService"/>
        </port>
    </service>
</definitions>
